# ==============================================================================
# HEFAETUS - Autonomous Dependency Remediation Agent
# Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Configuration
# ------------------------------------------------------------------------------
# Supported providers: 'gemini' (Free Tier), 'openai', 'anthropic'
# (Auto-detected if API key is provided)
LLM_PROVIDER=gemini

# --- Google Gemini (FREE TIER via Google AI Studio: https://aistudio.google.com/) ---
# Free Tier: 15 Requests/Min, 1M Tokens/Min, 1,500 Requests/Day (no credit card required)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# --- OpenAI API Key & Model (Alternative) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# --- Anthropic API Key & Model (Alternative) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# 2. GitHub Integration (PR Creation)
# ------------------------------------------------------------------------------
# GitHub Personal Access Token with repo scope permissions (read & write)
GITHUB_TOKEN=your_github_personal_access_token_here

# Target repository coordinates (for opening Pull Requests)
REPO_OWNER=your_github_username_or_org
REPO_NAME=mock-target-app

# ------------------------------------------------------------------------------
# 3. Execution & Sandbox Settings
# ------------------------------------------------------------------------------
# Execution mode:
#   'auto'   - Detects running Docker sandbox container; falls back to local execution
#   'docker' - Strict container mode (executes commands inside hefaetus-sandbox)
#   'local'  - Direct local Node.js process execution
EXECUTION_MODE=auto

# Docker container name for the isolated sandbox
SANDBOX_CONTAINER_NAME=hefaetus-sandbox

# Target app directory
MOCK_TARGET_DIR=../mock-target-app
